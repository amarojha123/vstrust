# Service auth: shared secret the Node backend sends in X-Service-Token
SERVICE_AUTH_TOKEN=change-me
ENVIRONMENT=development

# LLM provider: mock | openai | gemini
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_MAX_INPUT_TOKENS=12000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embeddings: hash (local, deterministic) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# Vector store: memory (FAISS-like local) | mongodb
VECTOR_STORE=memory
MONGODB_URI=
MONGODB_DB=trustmark

# Cost estimation (USD per 1K tokens), optional
COST_PER_1K_INPUT=0
COST_PER_1K_OUTPUT=0

MAX_CONTENT_CHARS=200000
