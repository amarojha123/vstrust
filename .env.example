NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/trustmark?replicaSet=rs0&directConnection=true
# Generate independently using: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
AI_SERVICE_TOKEN=
JWT_ISSUER=trust-mark
JWT_AUDIENCE=trust-mark-api
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=noreply@trustmark.local
AI_SERVICE_URL=http://localhost:8000
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY=http://api:4000
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
STORAGE_PATH=./private-storage
MAX_UPLOAD_BYTES=10485760
RUN_WORKER=true
JOB_POLL_MS=1000
JOB_LEASE_MS=60000
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
LOG_LEVEL=info
